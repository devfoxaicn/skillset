{
  "name": "skillset",
  "version": "0.1.0",
  "description": "Your Claude Skills, Set and Ready - One-click installation tool for Claude Skills",
  "main": "dist/index.js",
  "bin": {
    "skillset": "node ./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "skills",
    "cli",
    "anthropic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "octokit": "^4.0.2",
    "inquirer": "^9.3.7",
    "chalk": "^5.4.1",
    "ora": "^8.1.1",
    "fs-extra": "^11.3.0",
    "loglevel": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/inquirer": "^9.0.7",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.14",
    "typescript": "^5.7.3",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "templates"
  ]
